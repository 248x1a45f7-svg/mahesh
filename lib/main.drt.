      id: 5,
      category: 'Business',
      source: 'Market Watch',
      readMins: 3,
      title: 'Startups See Record Funding in Clean Energy',
      summary: 'Investors are backing battery and solar companies.',
      content:
          'Clean energy startups raised record funding this quarter as demand for batteries, solar panels and grid technology keeps climbing.',
      imageUrl: 'https://picsum.photos/seed/energy/600/300',
    ),
    Article(
      id: 6,
      category: 'Business',
      source: 'Biz Insider',
      readMins: 4,
      title: 'Remote Work Reshapes Office Rentals',
      summary: 'Companies are choosing smaller, flexible offices.',
      content:
