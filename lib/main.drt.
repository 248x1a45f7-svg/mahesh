import 'package:flutter/material.dart';

void main() => runApp(const NewsApp());

// ---------------- MODEL ----------------
class Article {
  final int id;
  final String title, summary, content, category, source, imageUrl;
  final int readMins;

  const Article({
    required this.id,
    required this.title,
    required this.summary,
    required this.content,
    required this.category,
    required this.source,
    required this.imageUrl,
    required this.readMins,
  });
}

// ---------------- CONTROLLER ----------------
enum ScreenState { loading, error, empty, data }

